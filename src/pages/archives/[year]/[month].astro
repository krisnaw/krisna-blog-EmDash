---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import { getReadingTime } from "../../../utils/reading-time";

const year = Number(Astro.params.year);
const month = Number(Astro.params.month);
const valid =
	Number.isInteger(year) &&
	year >= 1970 &&
	year <= 9999 &&
	Number.isInteger(month) &&
	month >= 1 &&
	month <= 12;

if (!valid) return Astro.redirect("/404");

const start = `${year}-${String(month).padStart(2, "0")}-01`;
const nextMonth = month === 12 ? 1 : month + 1;
const nextYear = month === 12 ? year + 1 : year;
const end = `${nextYear}-${String(nextMonth).padStart(2, "0")}-01`;
const label = new Date(Date.UTC(year, month - 1, 1)).toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	timeZone: "UTC",
});

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
	error,
} = await getEmDashCollection("posts", {
	where: { published_at: { gte: start, lt: end } },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (error) return new Response("Unable to load posts", { status: 500 });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((post) => post.data.id),
	"tag",
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
const archivePath = `/archives/${year}/${String(month).padStart(2, "0")}`;
---

<Base title={label} description={`Posts from ${label}`}>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">Archive</span>
			<h1 class="archive-title">{label}</h1>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="no-posts">No posts in this month.</p>
			) : (
				<div class="posts-grid">
					{filteredPosts.map(({ post, tags }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags.map((tag) => ({ slug: tag.slug, label: tag.label }))}
							edit={post.edit}
						/>
					))}
				</div>
			)
		}
		<nav class="pagination" aria-label="Pagination">
			{cursor && <a href={archivePath}>First page</a>}
			{
				nextCursor && (
					<a href={`${archivePath}?cursor=${encodeURIComponent(nextCursor)}`}>
						Next page
					</a>
				)
			}
		</nav>
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
